{
  "name": "cartera-edificios",
  "version": "0.2.0",
  "private": true,
  "description": "Administración de edificios, unidades, inquilinos y contratos, con login y permisos por rol.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "bcryptjs": "3.0.2",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "prisma": "6.9.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
