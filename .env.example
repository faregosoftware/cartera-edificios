# Copia este archivo como .env y completa los valores.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://cartera:cartera@localhost:5432/cartera?schema=public"

# Primer administrador (lo crea `npm run db:seed`). Deberá cambiar la contraseña al entrar.
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_NOMBRE="Administrador"
ADMIN_PASSWORD="CambiaEsta-2026"

# Zona horaria usada para "hoy" (vencimientos, estados de contrato)
APP_TZ="America/La_Paz"

# Encabezado de los recibos (opcional)
RECIBO_EMPRESA="Administración de Inmuebles"
RECIBO_NIT=""
RECIBO_DIRECCION=""
RECIBO_TELEFONO=""
